# Never commit machine-specific files
service.json
node_modules/
*.local.json

# Never commit actual secrets - use env vars instead
# opencode.jsonc should use {env:VAR} for all secrets

# IDE/OS noise
.DS_Store
Thumbs.db

# NOTE: opencode/skills/ is intentionally committed — 84 skills (manage-mcps,
# manage-skills, hyperframes* suite, media-use, and the gamedev-skills pack).
# Everything under opencode/skills/ replicates to new machines via the symlink.

# Backup files
*.backup
*.recovery
