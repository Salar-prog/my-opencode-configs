{
  "$schema": "https://opencode.ai/v2/cli.json",
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "image_preview": true,
    "permissions": "prompt"
  },
  "animations": true,
  "theme": {
    "name": "opencode"
  },
  "tabs": {
    "mode": "auto",
    "layout": "horizontal",
    "indicators": "status"
  },
  "attention": {
    "notifications": true,
    "sound": true
  },
  "terminal": {
    "copy": "select"
  },
  "debug": {
    "devtools": true
  },
  "experimental": {
    "new-designs": true,
    "client-mcp": false
  }
}
